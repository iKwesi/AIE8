# OpenAI API Key (required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (optional - for web search)
# Get your key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith API Key (optional - for tracing and monitoring)
# Get your key from: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# Guardrails API Key (optional - for guardrails validation)
# Get your key from: https://hub.guardrailsai.com/keys
GUARDRAILS_API_KEY=your_guardrails_api_key_here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to git (it's already in .gitignore)
